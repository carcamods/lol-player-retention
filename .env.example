# Copy to .env (git-ignored) and fill in. Never commit real values.

# Riot API key from https://developer.riotgames.com
# A Personal key never expires; a Development key expires every 24 h.
RIOT_API_KEY=

# Optional: requests allowed per routing value. Personal and dev keys: 20 per 1 s, 100 per 120 s.
# RIOT_RATE_LIMITS=20:1,100:120

# Optional: Discord webhook pinged when a `lolret collect` run ends.
DISCORD_WEBHOOK_URL=

# Where raw and processed data are written (git-ignored).
DATA_DIR=data

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
